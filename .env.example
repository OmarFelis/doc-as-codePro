# Configuración del Servicio
SERVICE_NAME=doc-as-code-service
VERSION=3.0.0
ENVIRONMENT=development
DEBUG=true

# AWS Bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=200000
BEDROCK_TEMPERATURE=0.5

# AWS Auth — elige UNA opción:
# Opción A: Bearer Token temporal (dev/testing)
AWS_BEARER_TOKEN=<bearer-token>
# Opción B: Credenciales IAM estáticas
# BEDROCK_AWS_ACCESS_KEY_ID=<access-key-id>
# BEDROCK_AWS_SECRET_ACCESS_KEY=<secret-access-key>
# AWS_SESSION_TOKEN=<session-token>  # requerido si son credenciales temporales

# Confluence
CONFLUENCE_BASE_URL=https://your-instance.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@company.com
CONFLUENCE_API_TOKEN=your-confluence-token
CONFLUENCE_VERIFY_SSL=false

# Jira Assets
JIRA_BASE_URL=https://your-instance.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-token
JIRA_WORKSPACE_ID=cb50f8bc-b8e8-4641-8301-f0096cbe8841

# EraserAI (opcional)
ERASER_API_KEY=your-eraser-key
ERASER_ENABLED=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=docascode
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# Analyzer
ANALYZER_MAX_FILE_SIZE_KB=500
ANALYZER_PARALLEL_PROCESSING=true
ANALYZER_MAX_WORKERS=4
